datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id            String   @id @default(cuid())
  title         String
  company       String
  location      String?
  description   String
  url           String   @unique
  source        String
  score         Int?
  aiReason      String?
  createdAt     DateTime @default(now())
}
